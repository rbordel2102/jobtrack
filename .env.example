DATABASE_URL="postgresql://USER:PASSWORD@POOLED_HOST/DATABASE"
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST/DATABASE"
BETTER_AUTH_SECRET="replace-with-a-random-development-secret"
BETTER_AUTH_URL="http://localhost:3000"
# El proveedor local es gratuito y no envía texto fuera de JobTrack.
JOBTRACK_AI_PROVIDER="local"
# OpenAI es opcional; solo se usa con JOBTRACK_AI_PROVIDER="openai".
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5.6-luna"
